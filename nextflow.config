params{
    genome="/shared/projects/mitra_mitra_2025/restart_2506/01_start/Mitra_mitra_genome.fasta"
    genome_msk="/shared/projects/mitra_mitra_2025/restart_2506/Mitra_mitra_newgenome.hardmasked.fasta"
    // Glob matches uniprotkb_D1/D2/D3.fasta. params.proteindatabase accepts a glob or a
    // comma-separated list of fasta files - each one runs through its OWN independent
    // clean/cluster/blast/exonerate branch (no cross-file merging or redundancy removal),
    // tagged with its own source id, so results/gene_models/gene_models.<id>.gff3 is always
    // traceable back to exactly one of these files. Same pattern as transcriptomes below;
    // see the NB above sourceId() and the workflow's protein-branch comment in main.nf.
    proteindatabase="/shared/projects/mitra_mitra_2025/restart_2506/01_start/uniprotkb_D*.fasta"
    // Glob matches all 13 assembly transcript files - same per-source-branch handling as
    // proteindatabase above (see main.nf).
    transcriptomes="/shared/projects/mitra_mitra_2025/restart_2506/01_start/spades_mimit*_transcripts_renamed.fa"
    species="mimit"
    chunkSize=10000
    // NB: outdir MUST be set here (nextflow.config), not as a `params.outdir = ...` line in
    // main.nf. Config is fully loaded before any module is parsed, whereas the `include`
    // statements at the top of main.nf parse every process definition - including any plain
    // (non-closure) "${params.outdir}/..." publishDir string - before main.nf's own later
    // lines get a chance to run. A default set only in main.nf is too late: every publishDir
    // had already locked in `null` at that point, publishing everything under a literal
    // "null/" directory instead of "results/". Setting it here avoids that ordering trap.
    outdir="results"
}

// NB: no container engine is enabled here at the top level - it's set only inside the
// profiles below, so each run picks exactly one (Singularity on the HPC, Docker locally).

// Lets Nextflow build/fetch containers on the fly from a process's `conda` directive
// (used by the exonerate and gmove modules, which have no pre-existing container image).
// NB: strategy must include 'container', not just 'conda' - 'conda' alone tells Wave to
// resolve ONLY processes with a conda directive, and to silently resolve every other
// process's container to nothing rather than passing through its `container:` string
// as-is. That's what caused fx2tab_genome (and every other plain-container process) to
// run unwrapped on the host instead of pulling its seqkit image.
wave {
    enabled = true
    strategy = ['container', 'conda']
}

process {
    memory = 30.GB
    // NB: params.nb_cpus was previously only printed in the log banner and never actually
    // applied to any process - every task ran at the default of 1 cpu regardless of the
    // -num_threads/-@/--cpu flags in the module scripts. This wires it up for real.
    cpus = { params.nb_cpus }
}

profiles {
    // The HPC/production run: Singularity, matching run_ANGE's `module load singularity`.
    // run_ANGE now passes -profile singularity explicitly - see that file.
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    // A small local run for trying the pipeline out end-to-end before pointing it at real
    // data. Point these paths at the sample files once you've put them together - see
    // README.md for what each one needs to contain. Uses Docker (Colima/Docker Desktop -
    // anything that provides the `docker` CLI + daemon) since Singularity is Linux-only
    // and won't be installed on a Mac.
    test {
        params {
            genome           = "${projectDir}/test_data/mini/test_genome.fasta"
            genome_msk       = "${projectDir}/test_data/mini/test_genome_masked.fasta"
            proteindatabase  = "${projectDir}/test_data/mini/test_proteins.fasta"
            transcriptomes   = "${projectDir}/test_data/mini/test_transcripts.fasta"
            species          = "test"
            chunkSize        = 500
            nb_cpus          = 2
        }
        process {
            cpus   = 2
            memory = 4.GB
        }
        docker.enabled = true
    }
}
